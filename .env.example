POSTGRES_DB=examflow
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow
DATABASE_URL=postgresql+asyncpg://examflow:examflow@postgres:5432/examflow
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-random-secret
FRONTEND_URL=http://localhost:13000
NEXT_PUBLIC_API_URL=/api/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: enables AI-powered .docx import (classify + split questions).
# Set OPENROUTER_API_KEY (preferred) or ANTHROPIC_API_KEY.
# Leave both empty to use the built-in heuristic parser instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
ANTHROPIC_API_KEY=
DOCX_AI_MODEL=claude-haiku-4-5
ADMIN_PHONE=+998900000001
ADMIN_PASSWORD=ChangeMe123!
COOKIE_SECURE=false
STORAGE_PATH=/data/uploads
